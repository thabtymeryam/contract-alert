# Copy this file to .env and fill in the values. docker compose reads .env automatically.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contractalert
# Must match the values above. Use host "db" inside Docker, "localhost" when running the backend directly.
DATABASE_URL=postgresql://postgres:postgres@db:5432/contractalert

# --- Auth ---
# Generate one with: openssl rand -hex 32
SECRET_KEY=change-me

# --- AI extraction ---
# "gemini" (Google API) or "ollama" (local models)
AI_PROVIDER=gemini

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Ollama on your host machine: http://host.docker.internal:11434
# Ollama via `docker compose --profile ollama up`: http://ollama:11434
# Backend running outside Docker: http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
# Context window in tokens; long contracts need a large one (uses more RAM)
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_SECONDS=600

# --- Frontend ---
# Only needed when running `npm run dev` outside Docker (docker compose sets it to http://backend:8000/api)
# BACKEND_API_URL=http://localhost:8000/api

# --- Ports (optional) ---
# POSTGRES_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# --- Email alerts ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_SSL=false,
# SMTP_USER and MAIL_FROM = your Gmail address, SMTP_PASSWORD = an App Password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for port 465 (implicit SSL); false uses STARTTLS (port 587)
SMTP_USE_SSL=false
MAIL_FROM=
# When the daily alert job runs (cron syntax, in ALERT_TIMEZONE)
ALERT_CRON=0 8 * * *
ALERT_TIMEZONE=Africa/Tunis
# Public URL of the web app, used for the "Open ContractAlert" button in emails
APP_URL=http://localhost:3000
